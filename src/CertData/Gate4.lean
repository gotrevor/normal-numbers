def W : Array Int := ((wString.splitOn " ").filter (· ≠ "")).toArray.map
  (fun t => (t.toInt?).getD 0)

/-- The automaton `sft449`; `99` = dead. -/
def sftT : Array (Nat × Nat) :=
  #[(1,13),(2,13),(3,13),(4,13),(99,5),(6,14),(99,7),(99,8),(9,15),(99,10),(99,11),(12,15),(99,13),
   (1,14),(1,15),(1,16),(17,99),(2,18),(19,99),(20,99),(3,21),(22,99),(23,99),(3,24),(1,99)]

def step (s d : Nat) : Nat := match sftT[s]? with
  | some p => if d = 0 then p.1 else p.2
  | none => 99

def one : Int := 2 ^ F
/-- `⌊v / 2^F⌋`. -/
def fl (v : Int) : Int := v / one

/-- Number of interior edges strictly below `r` (the `ρ`-bin index of `r`). -/
def rbin (r : Int) : Nat := edges.foldl (fun c e => if e < r then c + 1 else c) 0

/-- Weight of bin `(s, i, j)`. -/
def wt (s i j : Nat) : Int := W[s * N * M + i * M + j]!

/-- Minimum weight over the bins met by `x ∈ [xlo, xhi]` (mod 1), `ρ ∈ [rlo, rhi]`. -/
def leafmin (s : Nat) (xlo xhi rlo rhi : Int) : Int :=
  let f0 := fl xlo
  let ia := ((xlo - f0 * one) * Int.ofNat N) / one
  let ib := ((xhi - f0 * one) * Int.ofNat N) / one
  let ja := rbin rlo
  let jb := rbin rhi
  let nx := (ib - ia + 1).toNat
  let nj := jb + 1 - ja
  Nat.fold nx (fun t _ acc => Nat.fold nj (fun u _ acc =>
    min acc (wt s ((ia + Int.ofNat t) % Int.ofNat N).toNat (ja + u))) acc) (wt s ((ia % Int.ofNat N).toNat) ja)

/-- One window `[Ac - δ, Ac + δ]` against the cell `[c, c + h]`: `none` = possibly contained
(killed), else the updated zone bounds. -/
def wstep (cxlo cxhi crlo crhi Ac : Int) (z : Int × Int) : Option (Int × Int) :=
  if cxhi + crhi < Ac - dhi ∨ Ac + dhi < cxlo then some z
  else if max cxlo (Ac - dhi) ≤ min cxhi (Ac + dhi - crlo) then none
  else some ((if cxlo ≤ Ac + dhi ∧ Ac - dhi ≤ cxhi then max z.1 (Ac + dhi - cxlo) else z.1),
    (if cxlo + crlo ≤ Ac + dhi ∧ Ac - dhi ≤ cxhi + crhi then
      max z.2 (cxhi + crhi - (Ac - dhi)) else z.2))

/-- Window pass at a resolution: `none` = killed, else updated zones. -/
def windows (cxlo cxhi crlo crhi zl zr : Int) : Option (Int × Int) :=
  (List.range (fl (cxhi + crhi) + 2 - (fl cxlo - 1) + 1).toNat).foldl
    (fun acc (t : Nat) => acc.bind (wstep cxlo cxhi crlo crhi ((fl cxlo - 1 + Int.ofNat t) * one)))
    (some (zl, zr))

/-- A child box, given the recursive evaluator `g` one level down: at a resolution (`res`) run
the window pass, then rescale by 3 to the next stage. -/
def kidF (g : Nat → Int → Int → Int → Int → Int → Int → Int) (t : Nat)
    (cxlo cxhi hlo hhi czl czr : Int) (res : Bool) : Int :=
  if res then
    match windows cxlo cxhi hlo hhi czl czr with
    | none => 0
    | some z => g t (3 * (cxlo - fl cxlo * one)) (3 * (cxhi - fl cxlo * one)) (3 * hlo) (3 * hhi)
        (if 0 ≤ z.1 then 3 * z.1 else z.1) (if 0 ≤ z.2 then 3 * z.2 else z.2)
  else g t cxlo cxhi hlo hhi czl czr

/-- Contribution of binary child `d`. -/
def chF (g : Nat → Int → Int → Int → Int → Int → Int → Int) (s : Nat)
    (xlo xhi rlo rhi zl zr : Int) (d : Nat) : Int :=
  let hlo := rlo / 2
  let hhi := (rhi + 1) / 2
  let t := step s d
  if t = 99 then 0 else
  let cxlo := if d = 0 then xlo else xlo + hlo
  let cxhi := if d = 0 then xhi else xhi + hhi
  let czl := if d = 0 then zl else if hlo ≤ zl then zl - hlo else -1
  let czr := if d = 0 then (if hlo ≤ zr then zr - hlo else -1) else zr
  if 0 ≤ czl ∧ 0 ≤ czr ∧ hlo ≤ czl + czr then 0
  else if hhi ≤ 2 * dlo then kidF g t cxlo cxhi hlo hhi czl czr true
  else if 2 * dhi < hlo then kidF g t cxlo cxhi hlo hhi czl czr false
  else min (kidF g t cxlo cxhi hlo hhi czl czr true) (kidF g t cxlo cxhi hlo hhi czl czr false)

/-- Lower bound for the weighted count of good descendants `r` levels down. -/
def go : Nat → Nat → Int → Int → Int → Int → Int → Int → Int
  | 0, s, xlo, xhi, rlo, rhi, zl, zr =>
    if 0 ≤ zl ∨ 0 ≤ zr then 0 else leafmin s xlo xhi rlo rhi
  | r + 1, s, xlo, xhi, rlo, rhi, zl, zr =>
    chF (go r) s xlo xhi rlo rhi zl zr 0 + chF (go r) s xlo xhi rlo rhi zl zr 1

/-- Branch and bound: bisect `x` (even levels) or `ρ` (odd) while below target. -/
def bb : Nat → Nat → Int → Int → Int → Int → Int → Int
  | 0, s, xlo, xhi, rlo, rhi, _ => go D s xlo xhi rlo rhi (-1) (-1)
  | f + 1, s, xlo, xhi, rlo, rhi, tgt =>
    let v := go D s xlo xhi rlo rhi (-1) (-1)
    if tgt ≤ v then v else
    let a := if f % 3 ≠ 0 then bb f s xlo ((xlo + xhi) / 2) rlo rhi tgt
      else bb f s xlo xhi rlo ((rlo + rhi) / 2 / 2 ^ 20 * 2 ^ 20) tgt
    if a < tgt then a else
    let b := if f % 3 ≠ 0 then bb f s ((xlo + xhi) / 2) xhi rlo rhi tgt
      else bb f s xlo xhi ((rlo + rhi) / 2 / 2 ^ 20 * 2 ^ 20) rhi tgt
    min a b

/-- Bin box: `ρ`-ends `2 dlo` and `6 dhi` outside, interior edges inside. -/
def redge (j : Nat) : Int := if j = 0 then 2 * dlo else if j = M then 6 * dhi else edges[j - 1]!

/-- The check of bin `q`: zero weight, or `5^D · bb ≥ 9^D · W q`. -/
def checkBin (q : Nat) : Bool :=
  let w := W[q]!
  let s := q / (N * M); let i := (q / M) % N; let j := q % M
  w == 0 || decide (9 ^ D * w ≤ 5 ^ D * bb MAXB s (Int.ofNat i * one / Int.ofNat N) ((Int.ofNat i + 1) * one / Int.ofNat N) (redge j) (redge (j + 1))
    ((9 ^ D * w + 5 ^ D - 1) / 5 ^ D))

def checkRange (a b : Nat) : Bool := (List.range (b - a)).all fun t => checkBin (a + t)

end NormalNumbers.UniformBadThreshold.Coherent.Data
