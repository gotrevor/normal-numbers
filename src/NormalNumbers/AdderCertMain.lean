import NormalNumbers.AdderCert

/-!
# The main-family certificate (module 3, phase-1 tier)

Data generated by `experiments/adder_certificate_emit.py` from
`experiments/certs/adder_cert_main.json` (the emitter re-verifies
(C1)/(C1')/(C3') in Python and refuses to emit on failure).  Ambient
73728 states, 75 live, 8 simple cycles; `omega ≤ 7`, `rho ≤ 12`.

`live` is the 75-element index list, `rho` a 63-entry assoc list,
`forced` a 12-entry table; `omega` is stored as a 73728-character digit
string decoded through `ByteArray` (the KB frozen-table pattern).

`main_cert_ok` is phase-1: `native_decide` (disclosed `Lean.ofReduceBool`);
the kernel-tier swap is the recorded remainder.
-/

namespace NormalNumbers.Adder

/-- The 75 live states of the main family. -/
def mainLiveList : List ℕ := [10408, 10440, 10792, 10824, 16625, 16657, 17009, 17041, 25173, 25941, 26293, 26325, 28908, 28940, 29292, 29324, 29781, 30549, 34354, 34357, 34386, 34389, 34738, 34770, 35125, 35157, 35509, 35541, 39346, 39731, 39733, 39795, 40115, 40117, 40179, 40181, 43634, 43638, 43670, 44018, 44022, 44403, 44406, 44435, 44438, 44787, 44819, 48178, 48242, 48562, 48626, 49397, 49787, 49819, 50171, 50203, 52854, 52886, 53238, 53270, 54111, 54491, 54875, 57558, 58326, 58719, 59099, 64063, 66774, 67903, 67935, 68287, 68319, 68671, 68703]

def mainLive : ℕ → Bool := fun s => mainLiveList.contains s

/-- Nonzero ranks (63 entries). -/
def mainRhoList : List (ℕ × ℕ) := [(10408, 1), (10440, 1), (10792, 1), (10824, 1), (25173, 12), (25941, 7), (26293, 2), (26325, 3), (29781, 2), (30549, 2), (34354, 1), (34357, 2), (34386, 1), (34389, 7), (34738, 1), (34770, 1), (35125, 3), (35157, 10), (35509, 5), (35541, 1), (39346, 3), (39731, 2), (39733, 5), (39795, 2), (40115, 2), (40117, 8), (40179, 2), (40181, 4), (43634, 9), (43638, 3), (43670, 2), (44018, 6), (44022, 3), (44406, 2), (44438, 2), (48178, 4), (48242, 6), (48562, 11), (48626, 4), (49397, 4), (49787, 1), (49819, 1), (50171, 1), (50203, 1), (52854, 1), (52886, 1), (53238, 1), (53270, 1), (54111, 2), (54491, 6), (54875, 4), (57558, 4), (58326, 2), (58719, 12), (59099, 5), (64063, 3), (66774, 4), (67903, 2), (67935, 7), (68287, 1), (68319, 1), (68671, 3), (68703, 3)]

def mainRho : ℕ → ℕ := fun s => (mainRhoList.lookup s).getD 0

/-- The forced intra-cycle edges (12 entries). -/
def mainForced : ℕ → Option (ℕ × ℕ)
  | 16625 => some (1, 16625)
  | 16657 => some (1, 16657)
  | 17009 => some (1, 17009)
  | 17041 => some (1, 17041)
  | 28908 => some (0, 44403)
  | 28940 => some (0, 44435)
  | 29292 => some (0, 44787)
  | 29324 => some (0, 44819)
  | 44403 => some (3, 28908)
  | 44435 => some (3, 28940)
  | 44787 => some (3, 29292)
  | 44819 => some (3, 29324)
  | _ => none

/-- Dead-depths for all 73728 states, one digit `0`–`7` per state. -/
def mainOmegaStr : String :=
  ""

def mainOmegaBytes : ByteArray := mainOmegaStr.toUTF8

def mainOmega : ℕ → ℕ := fun s => (if h : s < mainOmegaBytes.size then (mainOmegaBytes.get s h).toNat else 48) - 48

/-- The main certificate passes the full check (phase-1: `native_decide`). -/
theorem main_cert_ok :
    checkCert mainFamily 73728 mainLive mainRho mainOmega mainForced = true := by
  native_decide

end NormalNumbers.Adder
