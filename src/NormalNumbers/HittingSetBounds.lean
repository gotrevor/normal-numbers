/-! ## The hitting-set theorems -/

/-- **`S(4,1) ≤ 3`.**  Three multipliers `{1, 10, 14}` hit every base-4 digit. -/
theorem hitting_4_1_three : Literature.IsHittingSet 4 1 {1, 10, 14} := by
  intro α hα w hw hd
  obtain ⟨d, rfl⟩ : ∃ d, w = [d] := by
    rcases w with _ | ⟨d, _ | ⟨e, t⟩⟩ <;> simp at hw
    exact ⟨d, rfl⟩
  have hd4 : d < 4 := hd d (by simp)
  have key : ∃ ch ∈ h41Chans d, ∀ N, ∃ n, N ≤ n ∧ OccursAt 4 (ch.a * α) ch.word n := by
    interval_cases d
    · exact signed_engine_g_single 4 (by norm_num) (h41Chans 0) rfl h41d0_cert α hα
        (by decide) (by decide) (by decide)
    · exact signed_engine_g_single 4 (by norm_num) (h41Chans 1) rfl h41d1_cert α hα
        (by decide) (by decide) (by decide)
    · exact signed_engine_g_single 4 (by norm_num) (h41Chans 2) rfl h41d2_cert α hα
        (by decide) (by decide) (by decide)
    · exact signed_engine_g_single 4 (by norm_num) (h41Chans 3) rfl h41d3_cert α hα
        (by decide) (by decide) (by decide)
  obtain ⟨ch, hch, hio⟩ := key
  fin_cases hch
  · exact ⟨1, by simp, by norm_num, by simpa using hio⟩
  · exact ⟨10, by simp, by norm_num, by simpa using hio⟩
  · exact ⟨14, by simp, by norm_num, by simpa using hio⟩

/-- **`S(5,1) ≤ 5`.**  The five multipliers `{1, 2, 3, 4, 6}` hit every base-5
digit.  Contrast `M(5,1) = 6` (`mahler_M_five_eq_six`): the initial segment
`{1,…,5}` fails (`not_hitting_5_1_five`), so the optimal hitting set is not an
initial segment. -/
theorem hitting_5_1_five : Literature.IsHittingSet 5 1 {1, 2, 3, 4, 6} := by
  intro α hα w hw hd
  obtain ⟨d, rfl⟩ : ∃ d, w = [d] := by
    rcases w with _ | ⟨d, _ | ⟨e, t⟩⟩ <;> simp at hw
    exact ⟨d, rfl⟩
  have hd5 : d < 5 := hd d (by simp)
  have key : ∃ ch ∈ h51Chans d, ∀ N, ∃ n, N ≤ n ∧ OccursAt 5 (ch.a * α) ch.word n := by
    interval_cases d
    · exact signed_engine_g_single 5 (by norm_num) (h51Chans 0) rfl h51d0_cert α hα
        (by decide) (by decide) (by decide)
    · exact signed_engine_g_single 5 (by norm_num) (h51Chans 1) rfl h51d1_cert α hα
        (by decide) (by decide) (by decide)
    · exact signed_engine_g_single 5 (by norm_num) (h51Chans 2) rfl h51d2_cert α hα
        (by decide) (by decide) (by decide)
    · exact signed_engine_g_single 5 (by norm_num) (h51Chans 3) rfl h51d3_cert α hα
        (by decide) (by decide) (by decide)
    · exact signed_engine_g_single 5 (by norm_num) (h51Chans 4) rfl h51d4_cert α hα
        (by decide) (by decide) (by decide)
  obtain ⟨ch, hch, hio⟩ := key
  fin_cases hch
  · exact ⟨1, by simp, by norm_num, by simpa using hio⟩
  · exact ⟨2, by simp, by norm_num, by simpa using hio⟩
  · exact ⟨3, by simp, by norm_num, by simpa using hio⟩
  · exact ⟨4, by simp, by norm_num, by simpa using hio⟩
  · exact ⟨6, by simp, by norm_num, by simpa using hio⟩

/-- **`S(2,2) ≤ 2`.**  The multipliers `{1, 3}` hit every binary 2-block. -/
theorem hitting_2_2_two : Literature.IsHittingSet 2 2 {1, 3} := by
  intro α hα w hw hd
  obtain ⟨a, b, rfl⟩ : ∃ a b, w = [a, b] := by
    rcases w with _ | ⟨a, _ | ⟨b, _ | ⟨c, t⟩⟩⟩ <;> simp at hw
    exact ⟨a, b, rfl⟩
  have ha : a < 2 := hd a (by simp)
  have hb : b < 2 := hd b (by simp)
  have key : ∃ ch ∈ h22Chans a b, ∀ N, ∃ n, N ≤ n ∧ OccursAt 2 (ch.a * α) ch.word n := by
    interval_cases a <;> interval_cases b
    · exact signed_engine_g_single 2 (by norm_num) (h22Chans 0 0) rfl h22w00_cert α hα
        (by decide) (by decide) (by decide)
    · exact signed_engine_g_single 2 (by norm_num) (h22Chans 0 1) rfl h22w01_cert α hα
        (by decide) (by decide) (by decide)
    · exact signed_engine_g_single 2 (by norm_num) (h22Chans 1 0) rfl h22w10_cert α hα
        (by decide) (by decide) (by decide)
    · exact signed_engine_g_single 2 (by norm_num) (h22Chans 1 1) rfl h22w11_cert α hα
        (by decide) (by decide) (by decide)
  obtain ⟨ch, hch, hio⟩ := key
  fin_cases hch
  · exact ⟨1, by simp, by norm_num, by simpa using hio⟩
  · exact ⟨3, by simp, by norm_num, by simpa using hio⟩

/-- **`S(2,3) ≤ 4`.**  The multipliers `{1, 3, 5, 7}` hit every binary 3-block. -/
theorem hitting_2_3_four : Literature.IsHittingSet 2 3 {1, 3, 5, 7} := by
  intro α hα w hw hd
  obtain ⟨a, b, c, rfl⟩ : ∃ a b c, w = [a, b, c] := by
    rcases w with _ | ⟨a, _ | ⟨b, _ | ⟨c, _ | ⟨d, t⟩⟩⟩⟩ <;> simp at hw
    exact ⟨a, b, c, rfl⟩
  have ha : a < 2 := hd a (by simp)
  have hb : b < 2 := hd b (by simp)
  have hc : c < 2 := hd c (by simp)
  have key : ∃ ch ∈ h23Chans a b c, ∀ N, ∃ n, N ≤ n ∧ OccursAt 2 (ch.a * α) ch.word n := by
    interval_cases a <;> interval_cases b <;> interval_cases c
    · exact signed_engine_g_single 2 (by norm_num) (h23Chans 0 0 0) rfl h23w000_cert α hα
        (by decide) (by decide) (by decide)
    · exact signed_engine_g_single 2 (by norm_num) (h23Chans 0 0 1) rfl h23w001_cert α hα
        (by decide) (by decide) (by decide)
    · exact signed_engine_g_single 2 (by norm_num) (h23Chans 0 1 0) rfl h23w010_cert α hα
        (by decide) (by decide) (by decide)
    · exact signed_engine_g_single 2 (by norm_num) (h23Chans 0 1 1) rfl h23w011_cert α hα
        (by decide) (by decide) (by decide)
    · exact signed_engine_g_single 2 (by norm_num) (h23Chans 1 0 0) rfl h23w100_cert α hα
        (by decide) (by decide) (by decide)
    · exact signed_engine_g_single 2 (by norm_num) (h23Chans 1 0 1) rfl h23w101_cert α hα
        (by decide) (by decide) (by decide)
    · exact signed_engine_g_single 2 (by norm_num) (h23Chans 1 1 0) rfl h23w110_cert α hα
        (by decide) (by decide) (by decide)
    · exact signed_engine_g_single 2 (by norm_num) (h23Chans 1 1 1) rfl h23w111_cert α hα
        (by decide) (by decide) (by decide)
  obtain ⟨ch, hch, hio⟩ := key
  fin_cases hch
  · exact ⟨1, by simp, by norm_num, by simpa using hio⟩
  · exact ⟨3, by simp, by norm_num, by simpa using hio⟩
  · exact ⟨5, by simp, by norm_num, by simpa using hio⟩
  · exact ⟨7, by simp, by norm_num, by simpa using hio⟩

/-! ## The base-5 lower wiring -/

/-- The initial segment `{1, 2, 3, 4}` is **not** a hitting set at base 5, block
length 1: the Mahler witness `2/4 + Σ 5^(−i!)` of `mahler_lower_bound_base5` has
digit `1` occurring only finitely often in `m·α` for every `1 ≤ m ≤ 5`. -/
theorem not_hitting_5_1_four : ¬ Literature.IsHittingSet 5 1 {1, 2, 3, 4} := by
  intro h
  obtain ⟨α, hα, hbad⟩ := Mahler.mahler_lower_bound_base5
  obtain ⟨m, hm, hm1, hio⟩ := h α hα [1] rfl (by simp)
  have hm5 : m ≤ 5 := by simp at hm; omega
  obtain ⟨N, hN⟩ := hbad m hm1 hm5
  obtain ⟨n, hn, hocc⟩ := hio N
  exact hN n hn hocc

/-- Neither is `{1, 2, 3, 4, 5}`: with `hitting_5_1_five` this shows the
minimal-size witness `{1, 2, 3, 4, 6}` is not an initial segment. -/
theorem not_hitting_5_1_five : ¬ Literature.IsHittingSet 5 1 {1, 2, 3, 4, 5} := by
  intro h
  obtain ⟨α, hα, hbad⟩ := Mahler.mahler_lower_bound_base5
  obtain ⟨m, hm, hm1, hio⟩ := h α hα [1] rfl (by simp)
  have hm5 : m ≤ 5 := by simp at hm; omega
  obtain ⟨N, hN⟩ := hbad m hm1 hm5
  obtain ⟨n, hn, hocc⟩ := hio N
  exact hN n hn hocc

end NormalNumbers.Adder
