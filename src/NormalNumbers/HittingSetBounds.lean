import NormalNumbers.AdderBaseG
import NormalNumbers.MahlerPrimeLowerBound
import NormalNumbers.Literature

/-!
# Hitting-set upper bounds `S(g,k) ≤ s` as theorems 🧵

The invariant `S(g,k)` (`docs/hitting-set-invariant-2026-09-13.md`) is the least
size of a per-block **hitting set** `Literature.IsHittingSet g k S`: every
irrational `α` and every `k`-block `w` over base `g` have some `m ∈ S` with `w`
occurring infinitely often in the base-`g` expansion of `m·α`.

This file turns four automaton verdicts (emitted and Python-verified by
`experiments/adder_baseg_emit.py h41 | h51 | h22 | h23`, certificates in
`experiments/certs/adder_cert_h*.json`) into theorems with the signed base-`g`
engine `signed_engine_g_single`, exactly as `MahlerBase5Exact.lean` proves
`M(5,1) ≤ 6`:

* `hitting_4_1_three` : `S(4,1) ≤ 3`, hitting set `{1, 10, 14}`;
* `hitting_5_1_five`  : `S(5,1) ≤ 5`, hitting set `{1, 2, 3, 4, 6}` — contrast
  `M(5,1) = 6` (`mahler_M_five_eq_six`): the set is not an initial segment;
* `hitting_2_2_two`   : `S(2,2) ≤ 2`, hitting set `{1, 3}`;
* `hitting_2_3_four`  : `S(2,3) ≤ 4`, hitting set `{1, 3, 5, 7}`.

The lower wiring `not_hitting_5_1_four` / `not_hitting_5_1_five` (the initial
segments `{1,…,4}`, `{1,…,5}` are **not** hitting sets at base 5) is
`Mahler.mahler_lower_bound_base5` unfolded at its witness and `w = [1]`.

Every certificate is a kernel `decide` (`decide +kernel`, no `native_decide`).
The `h23` family has ambient state space `26880`, so its edge sweep is split into
sixteen `1680`-state chunks (`checkEdgesOnA`) glued by `checkEdgesOnA_of_chunks`; the
omega ranking is packed `64` states per natural (`8` values each), the
`AdderTowerC8KData` scheme.  The matching lower bounds `S(g,k) ≥ s` are **not**
claimed here.
-/

namespace NormalNumbers.Adder

open NormalNumbers

/-! ## Chunk gluing for `checkEdgesOnA` -/

/-- Two adjacent edge sweeps glue to one. -/
theorem checkEdgesOnA_add {fstep : ℕ → ℕ → Option ℕ} {A : ℕ} {live : ℕ → Bool}
    {rho omega : ℕ → ℕ} {forced : ℕ → Option (ℕ × ℕ)} {lo n m : ℕ}
    (h1 : checkEdgesOnA fstep A live rho omega forced lo n = true)
    (h2 : checkEdgesOnA fstep A live rho omega forced (lo + n) m = true) :
    checkEdgesOnA fstep A live rho omega forced lo (n + m) = true := by
  have s1 := checkEdgesOnA_spec h1
  have s2 := checkEdgesOnA_spec h2
  unfold checkEdgesOnA
  rw [List.all_eq_true]
  intro i hi
  rw [List.mem_range] at hi
  rcases lt_or_ge i n with h | h
  · exact s1 i h
  · have := s2 (i - n) (by omega)
    rwa [show lo + n + (i - n) = lo + i by omega] at this

/-- Gluing with the arithmetic kept out of unification (a metavariable inside
`lo + n` makes the elaborator unfold the sweep itself and hit `maxRecDepth`). -/
theorem checkEdgesOnA_glue {fstep : ℕ → ℕ → Option ℕ} {A : ℕ} {live : ℕ → Bool}
    {rho omega : ℕ → ℕ} {forced : ℕ → Option (ℕ × ℕ)} {lo n lo' m n' : ℕ}
    (h1 : checkEdgesOnA fstep A live rho omega forced lo n = true)
    (h2 : checkEdgesOnA fstep A live rho omega forced lo' m = true)
    (hlo : lo' = lo + n) (hn : n' = n + m) :
    checkEdgesOnA fstep A live rho omega forced lo n' = true := by
  subst hlo hn
  exact checkEdgesOnA_add h1 h2

/-- `k` consecutive chunks of width `c` sweep `[0, k·c)`. -/
theorem checkEdgesOnA_of_chunks {fstep : ℕ → ℕ → Option ℕ} {A : ℕ} {live : ℕ → Bool}
    {rho omega : ℕ → ℕ} {forced : ℕ → Option (ℕ × ℕ)} {c : ℕ} :
    ∀ k : ℕ, (∀ j, j < k → ∀ lo, lo = j * c →
        checkEdgesOnA fstep A live rho omega forced lo c = true) →
      checkEdgesOnA fstep A live rho omega forced 0 (k * c) = true
  | 0, _ => by
    unfold checkEdgesOnA; simp
  | k + 1, h => by
    have ih := checkEdgesOnA_of_chunks k (fun j hj => h j (by omega))
    have hk := h k (by omega) (k * c) rfl
    exact checkEdgesOnA_glue ih hk (by ring) (by ring)

/-- A full sweep `[0, S)` plus the forced check is a certificate. -/
theorem checkCertA_of_edgesOn {fstep : ℕ → ℕ → Option ℕ} {A S : ℕ} {live : ℕ → Bool}
    {rho omega : ℕ → ℕ} {forced : ℕ → Option (ℕ × ℕ)}
    (h : checkEdgesOnA fstep A live rho omega forced 0 S = true)
    (hf : checkForcedA fstep A S live forced = true) :
    checkCertA fstep A S live rho omega forced = true := by
  apply checkCertA_of_parts _ hf
  apply checkEdgesA_of_edgeOkA
  intro s' hs'
  have := checkEdgesOnA_spec h s' hs'
  rwa [Nat.zero_add] at this

/-! ## Monotonicity -/

/-- A superset of a hitting set is a hitting set. -/
theorem _root_.NormalNumbers.Literature.IsHittingSet.mono {g k : ℕ} {S T : Finset ℕ}
    (h : Literature.IsHittingSet g k S) (hST : S ⊆ T) : Literature.IsHittingSet g k T := by
  intro α hα w hw hd
  obtain ⟨m, hm, h1, hio⟩ := h α hα w hw hd
  exact ⟨m, hST hm, h1, hio⟩

