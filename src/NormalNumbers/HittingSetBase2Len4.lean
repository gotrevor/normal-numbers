/-- The section hypothesis of `signed_engine_g_single_reduced`, from
`gfamState_window` and `h24_section`. -/
theorem h24_sec (X : ℝ) (w : List ℕ) (hw : w.length = 4) (m : ℕ) :
    h24Lget (h24idx (gfamState 2 (chansOfW h24ms w) X 0 m))
        = gfamState 2 (chansOfW h24ms w) X 0 m
      ∧ h24idx (gfamState 2 (chansOfW h24ms w) X 0 m) < 520 := by
  have hms : ∀ a ∈ h24ms, 1 ≤ a := by decide
  have hdvd : ∀ a ∈ h24ms, ∀ j, j ≤ 4 - 1 → a * 2 ^ j ∣ h24N := by decide
  have ht1 : Int.fract (X * ((2 : ℕ) : ℝ) ^ m) < 1 := Int.fract_lt_one _
  rw [gfamState_window 2 (by norm_num) h24ms hms w 4 hw h24N (by norm_num [h24N]) hdvd X m]
  refine h24_section _ ?_
  have hN0 : (0 : ℝ) < (h24N : ℝ) := by norm_num [h24N]
  have hfl : ⌊(h24N : ℝ) * Int.fract (X * ((2 : ℕ) : ℝ) ^ m)⌋ < (h24N : ℤ) := by
    apply Int.floor_lt.2
    push_cast
    calc (h24N : ℝ) * Int.fract (X * ((2 : ℕ) : ℝ) ^ m) < (h24N : ℝ) * 1 :=
          mul_lt_mul_of_pos_left ht1 hN0
      _ = (h24N : ℝ) := by ring
  have hpos' : 0 < h24N := by norm_num [h24N]
  omega

