def h24Lget (j : ℕ) : ℕ := h24L.getD j 0

def h24idx (s : ℕ) : ℕ := (bfind h24L s).getD 0

def h24step (w : List ℕ) : ℕ → ℕ → Option ℕ :=
  fun σ j => (gfamPred 2 (chansOfW h24ms w) (σ % 2) (σ / 2) (h24Lget j)).map h24idx

/-- The reachability check, as one list sweep (`native_decide`). -/
def h24ok (k : ℕ) : Bool :=
  decide (h24Lget (h24idx (stateOfKW 2 h24N 4 h24ms k)) = stateOfKW 2 h24N 4 h24ms k)
    && decide (h24idx (stateOfKW 2 h24N 4 h24ms k) < 520)

theorem h24_all : (List.range h24N).all h24ok = true := by native_decide

/-- **Reachability**: every index `k < 6126120` lands in `h24L`, below `520`. -/
theorem h24_section (k : ℕ) (hk : k < h24N) :
    h24Lget (h24idx (stateOfKW 2 h24N 4 h24ms k)) = stateOfKW 2 h24N 4 h24ms k
      ∧ h24idx (stateOfKW 2 h24N 4 h24ms k) < 520 := by
  have h := List.all_eq_true.1 h24_all k (List.mem_range.2 hk)
  simp only [h24ok, Bool.and_eq_true, decide_eq_true_eq] at h
  exact h

