#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["pytest"]
# ///
"""Persistent review controls: ./tail5-review test [pytest options]."""
import subprocess
import sys
from pathlib import Path

if len(sys.argv) < 2 or sys.argv[1] != "test":
    raise SystemExit("usage: tail5-review test [pytest options]")
raise SystemExit(subprocess.call([
    sys.executable, "-m", "pytest", "-q",
    str(Path(__file__).with_name("test_tail5_review.py")), *sys.argv[2:],
]))
